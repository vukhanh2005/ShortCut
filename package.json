{
  "name": "shortcut-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop video editor",
  "author": "ShortCut Studio contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write src electron tests scripts *.json *.ts *.html docs README.md",
    "format:check": "prettier --check src electron tests scripts *.json *.ts *.html docs README.md",
    "package": "npm run build && electron-builder --win portable --publish never",
    "package:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "^3.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "studio.shortcut.editor",
    "productName": "ShortCut Studio",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "ShortCut-Studio-${version}-Windows.exe" }
  }
}
